# One shell command per line, run from the repo root before any direct push to
# a branch listed in githooks/direct-push-ok. That file is deliberately ABSENT
# in pro-companion - no branch may be pushed directly; develop/main are entered
# by PR only. This list exists so that if a direct-ok branch is ever added, the
# push is gated on the suite rather than on nothing.
#
# It mirrors the CI job's host-side steps (#16). The emulator job is not here:
# it needs a device, so run it by hand with flutter test integration_test,
# sh integration_test/force_kill.sh and sh integration_test/offline_results.sh.
flutter analyze
flutter test
cd packages/core && dart test

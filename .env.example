# Names only - never values. Copy to .env.local (git-ignored) and fill in locally; CI reads the same
# names from the repository's Actions secrets. test/no_secrets_in_tree_test.dart refuses a value here
# and refuses any credential-shaped string anywhere in the tracked tree (pro-companion ADR 005, #39).
#
# The companion's own Supabase project: the API URL and the publishable key the app and CI use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# Not here: a personal access token (the Management API credential the CLI uses) belongs in your
# shell or in `supabase login`, never in this repository's folder.

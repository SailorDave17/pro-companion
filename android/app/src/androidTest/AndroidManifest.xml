<?xml version="1.0" encoding="utf-8"?>
<!-- The test APK only. Its stand-in service runs in the test package's own process and
     uid, so to the system it is another app (#19 criterion 4). Never shipped. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!-- Exported so the test can start it from the shell, which may start a
             foreground service from the background. -->
        <service
            android:name="com.procompanion.app.MediaStandInService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
